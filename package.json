{
  "name": "riccio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lista CRAS e triage per chi trova un riccio in difficoltà",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "data:build": "tsx scripts/build-data.ts",
    "data:stale": "tsx scripts/stale.ts",
    "validate": "tsx scripts/validate-cras.ts && tsx scripts/validate-triage.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright-core": "^1.48.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
